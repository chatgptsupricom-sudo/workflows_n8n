    {
      "parameters": {
        "jsCode": "const body = JSON.parse(JSON.stringify($('Webhook Meta (POST)').item.json.body));\n\nfor (const entry of body.entry || []) {\n  for (const msg of entry.messaging || []) {\n    if (msg.message) delete msg.message.referral;\n    delete msg.referral;\n  }\n}\n\nreturn [{ json: { cleanBody: JSON.stringify(body) } }];"
      },
