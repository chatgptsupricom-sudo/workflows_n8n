    {
      "parameters": {
        "jsCode": "// Ignorar mensajes echo (enviados por la pagina/Carlos)\nconst body = $input.first().json.body;\nconst results = [];\n\nconst entries = body?.entry || [];\nfor (const entry of entries) {\n  const messaging = entry?.messaging || [];\n  for (const msg of messaging) {\n    if (msg?.message?.is_echo === true) continue;\n\n    const referral = msg?.referral || msg?.message?.referral;\n    if (!referral) continue;\n\n    const instagram_id = msg?.sender?.id;\n    if (!instagram_id) continue;\n\n    results.push({\n      instagram_id: instagram_id.toString(),\n      ad_id: referral.ad_id || null,\n      adset_id: referral.adset_id || null,\n      campaign_id: referral.campaign_id || null,\n      ad_title: referral.ads_context_data?.ad_title || null,\n      source: referral.source || null,\n      ref: referral.ref || null,\n      timestamp: msg.timestamp || null\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -240
      ],
