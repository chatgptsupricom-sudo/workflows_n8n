    {
      "parameters": {
        "jsCode": "// 1. Obtener los datos directamente del input\nconst inputData = $input.item.json;\nconst body = inputData.body || {};\n\n// CORRECCIÓN: 'lead' va en minúsculas, igual que en el INPUT de n8n\nconst lead = body.lead || {}; \n\n// 2. Extraer y formatear el nombre del vendedor (Primera Letra Mayúscula)\nlet nameRaw = body.vendedor || \"Nuestro Equipo\";\nconst name = nameRaw\n  .toLowerCase()\n  .split(' ')\n  .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n  .join(' ');\n\n// 3. Extraer los identificadores comerciales usando la variable corregida\nconst seller_id = lead.seller_id || 0;\nconst asignacion = lead.asignacion || 0; \n\n// 4. Lógica de saneamiento de WhatsApp\nlet telefono = (lead.telefono || \"\").toString().replace(/\\D/g, \"\");\nif (telefono.startsWith(\"0\")) {\n  telefono = telefono.substring(1);\n}\nif (!telefono.startsWith(\"58\")) {\n  telefono = \"58\" + telefono;\n}\n\n// Mensaje institucional orientado al aliado B2B\nconst mensaje = `Hola, soy ${name} de Supricom. El equipo de marketing me envió tus datos para darte atención prioritaria. Mi objetivo es asegurar que tu negocio cuente con el respaldo de un mayorista en tecnología que necesitas.`;\nconst whatsappLink = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;\n\n// 5. Retornar el objeto con los mapeos correctos en minúsculas\nreturn [{\n  json: {\n    evento: body.evento || null,\n    vendedor: name,\n    seller_id: parseInt(seller_id) || 0,\n    AsignacionActual: parseInt(asignacion) || 0,\n    WhatsAppLink: whatsappLink,\n    \n    // Mapeo corregido usando 'lead' en minúsculas\n    nombre_contacto: lead.nombre_contacto || null,\n    empresa: lead.empresa || null,\n    telefono_local: lead.telefono || null,\n    rif: lead.rif || null,\n    ubicacion_estado: lead.ubicacion_estado || null,\n    ubicacion_detail: lead.ubicacion_detalle || null,\n    canal_origen: lead.canal_origen || null,\n    campana: lead.campana || null,\n    status: lead.status || null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
