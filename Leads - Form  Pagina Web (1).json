        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden\">\n  <div style=\"background:#0066CC;padding:20px 24px\">\n    <h2 style=\"color:#ffffff;margin:0\">🦁 SUPRICOM — Nuevo Lead Asignado</h2>\n  </div>\n  <div style=\"padding:24px\">\n    <p style=\"font-size:15px\">Hola <strong>{{ $('Mapear Campos Otros').item.json.Vendedor }}</strong>,</p>\n    <p style=\"font-size:15px\">Se te ha asignado un nuevo lead. Aquí están los datos:</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold;width:40%\">Contacto</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Otros').item.json['Nombre de Contacto'] }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8px 12px;font-weight:bold\">Empresa</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Otros').item.json['Nombre de la empresa'] }}</td>\n      </tr>\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold\">RIF</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Otros').item.json.RIF }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8px 12px;font-weight:bold\">WhatsApp</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Otros').item.json.WhatsApp }}</td>\n      </tr>\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold\">Ubicación</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Otros').item.json['Ubicacion detalle'] }} — {{ $('Mapear Campos Otros').item.json.Estado }}</td>\n      </tr>\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold\">Interés</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Otros').item.json.Interes }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8