    {
      "parameters": {
        "jsCode": "// 1. Como el nodo MySQL ya devuelve al vendedor ganador, tomamos ese item\n// 1. Como el nodo MySQL ya devuelve al vendedor ganador, tomamos ese item\nconst vendedor = items[0].json;\n\n// 2. Recuperar datos del Lead original\nconst leadData = $('¿Es Caracas / Carabobo?').item.json; \n\n// 3. L├│gica de WhatsApp\nlet telefono = (leadData.WhatsApp || \"\").toString().replace(/\\D/g, \"\");\nif (telefono.startsWith(\"0\")) {\n  telefono = telefono.substring(1);\n}\nif (!telefono.startsWith(\"58\")) {\n  telefono = \"58\" + telefono;\n}\n\n// Definir mensaje din├ímico con el nombre del vendedor obtenido de MySQL\n// CORRECCI├ôN: Se cambi├│ vendedor.nombre a vendedor.name\nconst nombreVendedor = vendedor.name || \"nuestro equipo\";\nconst mensaje = `Hola, soy ${nombreVendedor} de Supricom. El equipo de marketing me envi├│ tus datos para darte atenci├│n prioritaria. Mi objetivo es asegurar que tu negocio cuente con el respaldo de un mayorista en tecnolog├¡a que necesitas.`;\n\n// Generar el link\nconst whatsappLink = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;\n\n// 4. Retornar el objeto combinado\nreturn [{\n  json: {\n    ...leadData,\n    Vendedor: vendedor.name,\n    seller_id: vendedor.seller_id, // Usamos el ID de la tabla para el siguiente nodo\n    AsignacionActual: parseInt(vendedor.asignacion) || 0,\n    WhatsAppLink: whatsappLink\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -96
      ],
      "id": "06f4a5b1-e3c7-484f-9d7c-8ee27657e2b5",
      "name": "Armar Datos Vendedor Carcar"
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtener datos del lead y el vendedor (la fuente depende de la rama)\nconst leadData = $('¿Es Caracas / Carabobo?').item.json;\n// El nodo MySQL previo nos devuelve al vendedor ganador en items[0]\nconst vendedor = items[0].json;\n\n// 2. Limpiar el n├║mero de tel├®fono\nlet telefono = (leadData.WhatsApp || \"\").toString().replace(/\\D/g, \"\");\nif (telefono.startsWith(\"0\")) {\n  telefono = telefono.substring(1);\n}\nif (!telefono.startsWith(\"58\")) {\n  telefono = \"58\" + telefono;\n}\n\n// 3. Definir mensaje din├ímico\nconst nombreVendedor = vendedor.Vendedor || \"nuestro equipo\";\n// CORRECCI├ôN AQU├ì: Usamos ${leadData['Nombre de Contacto']} para inyectar el nombre real\nconst mensaje = `Hola ${leadData['Nombre de Contacto']}, soy ${nombreVendedor} de Supricom. El equipo de marketing me envi├│ tus datos para darte atenci├│n prioritaria. Mi objetivo es asegurar que tu negocio cuente con el respaldo de un mayorista en tecnolog├¡a que necesitas.`;\n\n// 4. Generar el link\nconst whatsappLink = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;\n\n// 5. Preparar objeto de retorno incluyendo el seller_id y el canal\nlet jsonRetorno = {\n    ...leadData,\n    Vendedor: vendedor.Vendedor,\n    seller_id: vendedor.seller_id,\n    WhatsAppLink: whatsappLink,\n    Canal: leadData.Canal || \"No definido\" // <--- Aqu├¡ capturamos el canal del lead\n};\n\nreturn [{\n  json: jsonRetorno\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        112
      ],
