    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=🦁 Nuevo Lead Asignado —  {{ $('Webhook').item.json.body.lead.nombre_contacto }}({{ $('Webhook').item.json.body.lead.ubicacion_estado }})",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden\">\n  <div style=\"background:#0066CC;padding:20px 24px\">\n    <h2 style=\"color:#ffffff;margin:0\">🦁 SUPRICOM — Nuevo Lead Asignado</h2>\n  </div>\n  <div style=\"padding:24px\">\n    <p style=\"font-size:15px\">Hola <strong>{{ $('Mapear Campos Carcar').item.json.Vendedor }}</strong>,</p>\n    <p style=\"font-size:15px\">Se te ha asignado un nuevo lead. Aquí están los datos:</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold;width:40%\">Contacto</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Carcar').item.json['Nombre de Contacto'] }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8px 12px;font-weight:bold\">Empresa</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Carcar').item.json[' Nombre de la empresa'] }}</td>\n      </tr>\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold\">RIF</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Carcar').item.json.RIF }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8px 12px;font-weight:bold\">WhatsApp</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Carcar').item.json.WhatsApp }}</td>\n      </tr>\n      <tr style=\"background:#f5f5f5\">\n        <td style=\"padding:8px 12px;font-weight:bold\">Ubicación</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Carcar').item.json['Ubicacion detalle'] }} — {{ $('Mapear Campos Carcar').item.json.Estado }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8px 12px;font-weight:bold\">Interés</td>\n        <td style=\"padding:8px 12px\">{{ $('Mapear Campos Carcar').item.json.Interes }}</td>\n      </tr>\n    </table>\n    \n    <div style=\"margin:28px 0;text-align:center\">\n      \n      <a href=\"{{ $('Mapear Campos Carcar').item.json.WhatsAppLink }}\"\n         style=\"background:#25D366;color:#ffffff;padding:14px 20px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:bold;display:inline-block;width:80%;max-width:260px;line-height:1.4;word-break:break-word;margin-bottom:12px;box-sizing:border-box\">\n        📲 Abrir WhatsApp con mensaje\n      </a>\n      <br>\n      \n      <a href=\"https://panel.supricom.com.ve/es/vendedores/leads\"\n         style=\"background:#0066CC;color:#ffffff;padding:14px 20px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:bold;display:inline-block;width:80%;max-width:260px;line-height:1.4;word-break:break-word;box-sizing:border-box\">\n        📊 Ver en Panel de Leads\n      </a>\n    </div>\n    \n    <p style=\"font-size:13px;color:#888\">Recuerda contactar al lead en las próximas horas para garantizar una correcta atención comercial y maximizar la conversión de la tienda.</p>\n  </div>\n  <div style=\"background:#f0f0f0;padding:12px 24px;text-align:center\">\n    <p style=\"font-size:12px;color:#aaa;margin:0\">SUPRICOM. Tu mayorista de confianza. 🦁</p>\n  </div>\n</div>",
        "options": {}
